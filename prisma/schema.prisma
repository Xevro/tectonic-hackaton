generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Customer {
  id            String           @id
  name          String
  firstName     String
  email         String
  persona       String
  blurb         String
  accounts      Account[]
  bills         Bill[]
  savingsPlans  SavingsPlan[]
  goals         Goal[]
  memories      MemoryItem[]
  conversations Conversation[]
  actions       ProposedAction[]
}

model Account {
  id           String        @id @default(cuid())
  customerId   String
  customer     Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  name         String
  kind         String
  purpose      String?
  iban         String
  balanceCents Int
  transactions Transaction[]
}

model Transaction {
  id          String   @id @default(cuid())
  accountId   String
  account     Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  amountCents Int
  label       String
  bookedOn    DateTime
  posted      Boolean  @default(true)
  kind        String
}

model Bill {
  id          String   @id @default(cuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label       String
  amountCents Int
  dueOn       DateTime
  paid        Boolean  @default(false)
  purpose     String?
}

model SavingsPlan {
  id          String   @id @default(cuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  name        String
  amountCents Int
  dayOfMonth  Int
  active      Boolean  @default(true)
  skipMonth   String?
}

model Goal {
  id          String    @id @default(cuid())
  customerId  String
  customer    Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  key         String
  label       String
  targetCents Int
  savedCents  Int       @default(0)
  dueOn       DateTime?

  @@unique([customerId, key])
}

model MemoryItem {
  id         String    @id @default(cuid())
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  kind       String
  key        String
  label      String
  value      String
  source     String
  status     String
  observedAt DateTime  @default(now())
  expiresAt  DateTime?
  updatedAt  DateTime  @updatedAt

  @@unique([customerId, key])
}

model Conversation {
  id         String    @id @default(cuid())
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
  closedAt   DateTime?
  messages   Message[]
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String
  citedKeys      String       @default("")
  createdAt      DateTime     @default(now())
}

model ProposedAction {
  id          String    @id @default(cuid())
  customerId  String
  customer    Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  type        String
  title       String
  explanation String
  reasoning   Json
  payload     Json
  status      String
  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?
}
